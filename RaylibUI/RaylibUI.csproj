<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" />
    <PackageReference Include="Raylib-CSharp" />
    <InternalsVisibleTo Include="RhyCiv.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\UI.Classic\UI.Classic.csproj" />
    <ProjectReference Include="..\UI.Compact\UI.Compact.csproj" />
    <ProjectReference Include="..\UI.CompatAlternate\UI.CompatAlternate.csproj" />
    <ProjectReference Include="..\Engine\RhyCiv.Engine.csproj" />
    <ProjectReference Include="..\Model\Model.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
    <Compile Remove="IScreen.cs" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <None Update="Shaders\base.vs" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Shaders\grayscale.fs" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Shaders\color-correction.fs" CopyToOutputDirectory="PreserveNewest" />
    <None Update="FOSSart\**\*" CopyToOutputDirectory="PreserveNewest" TargetPath="%(Identity)" />
    <None Include="..\LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\NOTICE.md" Link="NOTICE.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\ASSET-MANIFEST.tsv" Link="ASSET-MANIFEST.tsv" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
