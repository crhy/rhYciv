<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Moq" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="NeoLua" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Model\Model.csproj" />
    <ProjectReference Include="..\Engine\RhyCiv.Engine.csproj" />
    <ProjectReference Include="..\UI.Classic\UI.Classic.csproj" />
    <ProjectReference Include="..\RaylibUtils\RaylibUtils.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The pure font-size and font-baking decisions in RaylibUI are not reachable
         through the project references (RaylibUI needs a GL context); compile them
         in so they can be tested. Their raylib P/Invokes are only ever called in
         the Draw paths, which these tests do not touch. -->
    <Compile Include="..\RaylibUI\TextRendering.cs" Link="TextRendering.cs" />
    <Compile Include="..\RaylibUI\Initialization\FontPlan.cs" Link="FontPlan.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
